#!/bin/bash
# Turn the display off when the panel backlight reaches 0%.
#
# A backlight value of 0 still emits a faint image on some panels, so 0%
# brightness alone does not blank the screen. This watcher issues the same
# DPMS dispatch that `omarchy-brightness-display off` uses, and turns the
# display back on as soon as brightness rises above 0%.
#
# It also re-asserts DPMS off while brightness stays at 0%: idle and lock wake
# paths call `omarchy-brightness-display on`, which would otherwise relight a
# 0% panel.

set -u

PATH="/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

resolve_node() {
  local device
  device=$(omarchy-hw-display 2>/dev/null) || return 1
  [[ -n $device && -r /sys/class/backlight/$device/brightness ]] || return 1
  printf '/sys/class/backlight/%s/brightness\n' "$device"
}

node=$(resolve_node) || exit 1

zero=0
last=""

dpms() {
  hyprctl dispatch "hl.dsp.dpms({ action = \"$1\" })" >/dev/null 2>&1
}

internal_monitor() {
  hyprctl monitors -j 2>/dev/null |
    jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")) | .name' |
    head -n 1
}

while :; do
  if [[ ! -r $node ]]; then
    sleep 2
    node=$(resolve_node) || continue
    last=""
    continue
  fi

  value=$(cat "$node" 2>/dev/null) || { sleep 1; continue; }

  if [[ $value != "$last" ]]; then
    last=$value
    if (( value == 0 )); then
      zero=1
      dpms disable
    elif (( zero )); then
      zero=0
      dpms enable
    fi
  elif (( zero )); then
    monitor=$(internal_monitor)
    if [[ -n $monitor ]] && hyprctl monitors -j 2>/dev/null |
      jq -e --arg m "$monitor" 'any(.[]; .name == $m and .dpmsStatus == true)' >/dev/null; then
      dpms disable
    fi
    sleep 1
    continue
  fi

  sleep 0.25
done

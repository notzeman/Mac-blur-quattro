[Unit]
Description=Turn the display off when the panel backlight reaches zero
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.config/omarchy/scripts/brightness-zero-dpms
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target

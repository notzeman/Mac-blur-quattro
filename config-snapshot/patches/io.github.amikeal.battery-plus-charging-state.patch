diff --git i/Model.js w/Model.js
index de7b1b7..0ccabd2 100644
--- i/Model.js
+++ w/Model.js
@@ -3,21 +3,43 @@
 // Nerd Font battery glyphs (Material Design set, matching the built-in power widget).
 var DISCHARGE = ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
                  "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"];
-var CHARGE    = ["󰂜", "󰂆", "󰂇", "󰂈", "󰂝",
-                 "󰂉", "󰂞", "󰂊", "󰂋", "󰂅"];
-var FULL_ICON = "󰂅";       // 󰂅
-var ALERT_ICON = "󰂃";      // 󰂃
+var CHARGE    = ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝",
+                 "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"];
+var FULL_ICON = "󰂅";       // battery-charging / full
+var ALERT_ICON = "󰂃";      // battery-alert
+var PLUGGED_ICON = "󰚥";    // power-plug: AC connected, battery not charging
 
 function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
 
-function batteryIcon(percent, status) {
-  var i = clamp(Math.floor((Number(percent) || 0) / 10), 0, 9);
+function isOnAc(acOnline) {
+  return acOnline === true || Number(acOnline) === 1;
+}
+
+function batteryIcon(percent, status, acOnline) {
+  var pct = Number(percent) || 0;
+  var i = clamp(Math.floor(pct / 10), 0, 9);
   if (status === "Full" || status === "FullyCharged") return FULL_ICON;
+  if (isOnAc(acOnline) && pct >= 99) return FULL_ICON;
   if (status === "Charging") return CHARGE[i];
-  if (status === "Discharging" && percent <= 10) return ALERT_ICON;
+  // UPower reports PendingCharge when a charge threshold holds the battery,
+  // and some firmware reports Unknown while still connected. A plugged-in
+  // battery that is not charging must not look like it is on battery power.
+  if (isOnAc(acOnline) && status !== "Discharging") return PLUGGED_ICON;
+  if (status === "Discharging" && pct <= 10) return ALERT_ICON;
   return DISCHARGE[i];
 }
 
+// Short state label for the bar tooltip and the panel's stats row.
+function statusLabel(b) {
+  if (!b || !b.present) return "No battery";
+  if (b.status === "Full" || b.status === "FullyCharged"
+      || (isOnAc(b.acOnline) && Number(b.percent) >= 99)) return "Fully charged";
+  if (b.status === "Charging") return "Charging";
+  if (isOnAc(b.acOnline)) return "Plugged in · not charging";
+  if (b.status === "Discharging") return "On battery";
+  return "Battery " + (Number(b.percent) || 0) + "%";
+}
+
 function fmtWatts(w) {
   var n = Number(w) || 0;
   return (n >= 10 ? n.toFixed(1) : n.toFixed(2)) + " W";
@@ -34,9 +56,10 @@ function fmtDuration(mins) {
 // Hero meta line, e.g. "ON BATTERY · 10.2 W" / "CHARGING · 22 W" / "FULLY CHARGED".
 function modeLabel(b) {
   if (!b || !b.present) return "NO BATTERY";
-  if (b.status === "Full" || (b.acOnline && b.percent >= 99)) return "FULLY CHARGED";
+  if (b.status === "Full" || b.status === "FullyCharged"
+      || (isOnAc(b.acOnline) && Number(b.percent) >= 99)) return "FULLY CHARGED";
   if (b.status === "Charging") return "CHARGING · " + fmtWatts(b.watts);
-  if (b.acOnline) return "ON AC";
+  if (isOnAc(b.acOnline)) return "PLUGGED IN · NOT CHARGING";
   return "ON BATTERY · " + fmtWatts(b.watts);
 }
 
